# Provider-specific credentials prevent one remote model from overwriting another.
DEEPSEEK_API_KEY=
QWEN38_API_KEY=
# Zhipu GLM (glm-5.3-flash) API key from https://bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=
# Tencent Hunyuan Hy4 (hy4-preview) API key from TokenHub console.
# Optional base URL override; leave blank to keep the CN (Guangzhou) default. Use
# https://tokenhub-intl.tencentmaas.com/v1 if the account is on the SG site.
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=
# Legacy/default key used only by custom profiles that explicitly select it.
LLM_API_KEY=
OMLX_API_KEY=
MTPLX_API_KEY=
LLM_MODEL=Qwen3.6-35B-A3B
LLM_BASE_URL=http://127.0.0.1:8081/v1
# Overall deadline for remote LLM requests (seconds). Default 60s; raise for
# slow-thinking models (e.g. GLM-5.3-Flash) whose streamed reasoning exceeds it.
LLM_OVERALL_TIMEOUT=300
# Optional shared wall-clock budget per turn, including user/approval waits.
# 0 disables it; /budget 60 changes subsequent turns in the current process.
ASTRA_TURN_TIMEOUT_SECONDS=0
# Maximum silence between meaningful stream updates; active reasoning is not idle.
LLM_IDLE_TIMEOUT=120
# Preserve stable system-prompt prefixes on supported models (official V4.1).
# Set to 0 to keep a single leading system message for compatibility diagnosis.
# ASTRA_SYSTEM_PROMPT_HISTORY=1
# Stable persona/basic rules; the model reads astra-core through skill_view
# before engineering/browser/desktop work. No automatic chat/work injection.
# Set full to restore the original complete contract. Restart after changing.
# ASTRA_CORE_RULES_MODE=skill
# Reuse identical original-resolution DeepSeek images via expiring file IDs.
# Upload batch timeout is 3s, failures fall back inline with a 120s cooldown.
# ASTRA_DEEPSEEK_FILES=1
# Optional metadata cache path; defaults to ~/.cache/astra/deepseek-files.db.
# ASTRA_DEEPSEEK_FILE_CACHE=
# Optional read-only 163 mail integration. Use a 163 client authorization code, not the web password.
# ASTRA_163_EMAIL=your-account@163.com
# ASTRA_163_AUTH_CODE=
# ASTRA_163_MAX_BODY_BYTES=5242880
# Maximum concurrent subagents. The runtime hard cap is 5.
ASTRA_DELEGATE_CONCURRENCY=5
# Keep one parent task from occupying every global subagent slot.
ASTRA_DELEGATE_OWNER_CONCURRENCY=2

# Optional native Windows process-tree containment for local shell/worker runs.
# This uses Job Objects (tree kill + process/memory/CPU limits); it is not a
# filesystem or credential sandbox. WSL execution is rejected while enabled.
ASTRA_WINDOWS_JOB_CONTAINMENT=off
ASTRA_WINDOWS_JOB_MAX_PROCESSES=64

# Automatically discovered AGENTS.md, project skills, and .astra/mcp.json are
# ignored by default. Trust only a workspace you control, either for this
# process or via an OS-path-separated allowlist of absolute project roots.
ASTRA_PROJECT_TRUST=0
ASTRA_TRUSTED_PROJECTS=
# Minimum completion budget for investigation turns (clamped to 131072).
DELEGATE_INVESTIGATE_MAX_TOKENS=16384
# Astra is direct by default and does not inherit a parent process proxy.
# To opt in, set HTTP(S)_PROXY here and choose auto (probe first) or always.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ASTRA_PROXY_MODE=auto  # off (default) | auto | always
# ASTRA_PROXY_PROBE_TIMEOUT=0.25

# Minimal Mode persistent Bash: Windows uses WSL Bash; macOS/Linux uses native
# Bash. Commands default to a 300-second timeout.
# ASTRA_PERSISTENT_BASH_TIMEOUT is the preferred cross-platform override and
# takes precedence when both variables are set.
# ASTRA_PERSISTENT_BASH_TIMEOUT=300
# ASTRA_WSL_PERSISTENT_TIMEOUT is the legacy fallback, read only when the
# preferred variable is unset.
# ASTRA_WSL_PERSISTENT_TIMEOUT=

# Agent only connects to local servers; it does not start or stop llama-server.
QWEN_BASE_URL=http://127.0.0.1:8081/v1
GEMMA_BASE_URL=http://127.0.0.1:8083/v1

# Optional local Docker image for Minimal/run_code project checks. Leave empty
# to use the small upstream image, or build the dev image with
# scripts/build-sandbox-image.ps1 on Windows or scripts/build-sandbox-image.sh
# on macOS/Linux first.
# ASTRA_DOCKER_IMAGE=astra-sandbox:agent-system-dev

# Web search: auto routes news/research queries to Exa and falls back to SearXNG.
WEB_SEARCH_PROVIDER=auto
SEARXNG_URL=http://127.0.0.1:8080
EXA_API_KEY=
# Alternatively, reuse EXA_API_KEY from another dotenv file without copying the secret.
EXA_ENV_FILE=
EXA_API_URL=https://api.exa.ai
EXA_SEARCH_TYPE=auto
EXA_SEARCH_TIMEOUT=15

# Web extraction: configured APIs first, then Firecrawl, then direct HTTP.
WEB_EXTRACT_PROVIDER=auto
WEB_EXTRACT_API_TIMEOUT=30
WEB_EXTRACT_CACHE_DIR=.astra/cache/web
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com
TAVILY_EXTRACT_DEPTH=basic
PARALLEL_API_KEY=
PARALLEL_API_URL=https://api.parallel.ai
FIRECRAWL_API_KEY=
FIRECRAWL_URL=http://127.0.0.1:3002
FIRECRAWL_TIMEOUT=60

# Optional browser extractor. Prefer BROWSER_EXTRACT_ARGV, a JSON array that
# preserves Windows paths/spaces without shell parsing. BROWSER_EXTRACT_CMD is
# preferred among legacy shell strings; WSL_EXTRACT_CMD remains a legacy
# fallback on every platform. BROWSER_EXTRACT_STATUS_CMD is an independent
# readiness command; without it, custom extractors receive no fake URL/status
# argument. Defaults use WSL only for Windows Python and native Bash for
# macOS/Linux (including Python inside WSL). On a checkout copied from Windows
# to macOS/Linux, unset or replace WSL_EXTRACT_CMD. Windows legacy URLs reject
# raw double quotes, CR, LF, and NUL; use percent encoding or JSON argv instead.
# BROWSER_EXTRACT_ARGV=["C:\\Program Files\\Browser Extract\\extract.exe","--render"]
# BROWSER_EXTRACT_CMD=
# BROWSER_EXTRACT_STATUS_CMD=
# WSL_EXTRACT_CMD=

# Optional Hermes history import paths. CLI --source-db/--target-db arguments
# take precedence; see docs/memory.md before importing into durable Astra state.
# HERMES_DB=/path/to/.hermes/state.db
# ASTRA_SESSIONS_DB=.astra/sessions.db

# Optional read-only source locations for the Proactive Context Index. These
# only choose existing SQLite files; they do not enable recommendations. The
# feature remains off until `/context-index session` or `/context-index all`.
# ASTRA_CONTEXT_INDEX_SESSIONS_DB=.astra/sessions.db
# ASTRA_CONTEXT_INDEX_ACTIVITY_DB=.astra/activity-history.sqlite3

# Optional production controls
AGENT_TOOL_POLICY=permissive
# Host filesystem mounts. The workspace is always read-write; extra roots are
# read-only/read-write according to this JSON file and are not Docker mounts.
AGENT_FILESYSTEM_CONFIG=.astra/filesystem.json
# Large tool results are previewed inline and saved in full under this directory.
TOOL_MAX_INLINE_CHARS=12000
TOOL_MAX_FRESH_RESULT_CHARS=100000
TOOL_RESULT_DIR=.astra/tool-results
# Open a per-tool circuit after this many consecutive equivalent failures.
TOOL_FAILURE_THRESHOLD=3
# Keep the provider-visible tool manifest byte-stable for prefix-cache reuse.
# Set to 0 only when minimizing the first uncached request matters more than
# repeated-request cache cost.
PROMPT_CACHE_STABLE_TOOLS=1
# Every default tool schema is sent with each request. Comma-separated names:
# AGENT_TOOL_EXPOSE adds opt-in tools (conclave, notebook_execute, skills_list,
# project_verifier_init, git_pull, git_reset, git_revert, extract_url,
# browser_extract, search_status); AGENT_TOOL_HIDE removes default ones. A tool named in both stays hidden.
# AGENT_TOOL_EXPOSE=
# AGENT_TOOL_HIDE=
# Opt-in redacted request profiling. Stores hashes, token estimates, timings,
# and provider cache counters under .astra/query-profile.jsonl, plus bounded
# storage/tool/event/frontend timings under .astra/runtime-profile.jsonl.
# No prompt, argument or result contents are recorded. Restart to apply.
ASTRA_PROFILE_QUERY=0
ASTRA_QUERY_PROFILE_MAX_BYTES=5242880
ASTRA_QUERY_PROFILE_BACKUPS=2
# Legacy opt-out path used only when PROMPT_CACHE_STABLE_TOOLS=0.
# Expose core/relevant tool groups first; the model can activate another group on demand.
TOOL_PROGRESSIVE_EXPOSURE=1
# 0 disables only the fixed total-iteration ceiling. Repeat/failure/token guards remain active.
AGENT_MAX_REACT_ITERATIONS=50
# Ink TUI: collapse verbose tool cards above either threshold.
TUI_TOOL_COLLAPSE_CHARS=700
TUI_TOOL_COLLAPSE_LINES=6
TUI_MAX_TOOL_RESULTS=100
# Maximum visible rows in the slash-command suggestion window.
TUI_COMMAND_MENU_ROWS=8
AGENT_MCP_CONFIG=.astra/mcp.json
AGENT_SKILLS_PATH=.astra/skills
# Optional automatic retention of tool-authored evidence only, with a 90-day TTL.
# Conversation text is never classified into facts or corrections by this path.
# Model-directed memory tools and /memory commands work independently of this switch.
MEMORY_AUTO_RETAIN=0
# Legacy conservative/evolving values are accepted but now use tool-evidence policy.
MEMORY_RETENTION_MODE=tool-evidence
# Optional semantic recall and asynchronous full-session synchronization.
# Builtin SQLite retention/recall remains authoritative when this is disabled.
# Windows can reach a WSL localhost-bound service through localhost forwarding.
HINDSIGHT_ENABLED=0
HINDSIGHT_API_URL=http://127.0.0.1:8888
HINDSIGHT_BANK_ID=main-v2
HINDSIGHT_BUDGET=mid
HINDSIGHT_RECALL_MAX_TOKENS=800
HINDSIGHT_TIMEOUT=8
# The processing model is configured by the Hindsight service, not sent per request.
HINDSIGHT_PROCESSING_MODEL=deepseek-flash
# Changing this label does not configure the Windows/WSL server. In its own
# service environment (e.g. profiles/main.env), set all active model overrides:
# HINDSIGHT_API_LLM_MODEL=deepseek-flash
# HINDSIGHT_API_RETAIN_LLM_MODEL=deepseek-flash
# HINDSIGHT_API_CONSOLIDATION_LLM_MODEL=deepseek-flash
# HINDSIGHT_API_REFLECT_LLM_MODEL=deepseek-flash
# Reload the service/worker environment; keep its provider, URL and keys.
HINDSIGHT_SESSION_SYNC=0
HINDSIGHT_SESSION_SYNC_EVERY_N_TURNS=3
# Keep 0 for ordered, lossless append processing. 1 is lower-latency but the
# Hindsight background worker does not guarantee same-document update ordering.
HINDSIGHT_SESSION_SYNC_ASYNC=0
# Synchronous retain can legitimately exceed 30s. The cursor is saved only
# after the service response, so a short client timeout causes full re-sends.
HINDSIGHT_SESSION_SYNC_TIMEOUT=180
# Back off after a failed retain instead of retrying on every later user turn.
HINDSIGHT_SESSION_SYNC_FAILURE_COOLDOWN=300
HINDSIGHT_SESSION_SYNC_MAX_COOLDOWN=21600
# Hindsight server (profiles/main.env): HINDSIGHT_API_RETAIN_LLM_MAX_RETRIES is
# the TOTAL attempt count (range(n)), NOT retries-after-first. 0 means the LLM
# is never called and retain fails instantly with "after 0 attempts"; use >=1.
HINDSIGHT_API_RETAIN_LLM_MAX_RETRIES=1
# Tests are hard-isolated from live Hindsight unless a dedicated integration test opts in.
HINDSIGHT_SESSION_SYNC_IN_TESTS=0
# Remote/cloud hosts remain blocked unless this is explicitly enabled.
HINDSIGHT_ALLOW_REMOTE=0
# Direct skill accumulation. /learn mode off disables saves; manual review remains available.
LEARNING_REVIEW_MODE=review
# Skill review runs only on /learn review: 20 skills / 24K input characters,
# 4096 output tokens, 90 seconds, one model request, no retry or scheduler.
# Legacy LEARNING_REVIEW_AUTO/INTERVAL/IDLE_DELAY/CANDIDATE_REMINDERS flags are ignored.
AGENT_TRACE_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces

# Override the directory used by backend/CLI sessions. Defaults to the
# project-local .sessions directory; tests use this to stay hermetic.
# AGENT_SESSION_DIR=/absolute/path/to/sessions

# run_code (PTC) budgets. Defaults are intentionally generous for multi-step
# programs but can be lowered for tighter loops.
RUN_CODE_MAX_CALLS_PER_TURN=32
RUN_CODE_MAX_TOOL_CALLS=100
RUN_CODE_TIMEOUT_SECONDS=120
# Context Index embedding: auto selects MLX on macOS, llama.cpp elsewhere.
# Windows activity recorder (opt-in via scripts/activity-control.bat):
# ASTRA_ACTIVITY_EXCLUDE_APPS=example.exe,another.exe
# ASTRA_ACTIVITY_EXCLUDE_TITLES=InPrivate,Incognito,隐身,无痕
# ASTRA_ACTIVITY_EXCLUDE_DOMAINS=example.com,another.example
# GGUF server: llama-server -m model.gguf --embedding --pooling last --port 8088
# ASTRA_EMBEDDING_BACKEND=auto
# ASTRA_EMBEDDING_BASE_URL=http://127.0.0.1:8088/v1
# ASTRA_EMBEDDING_MODEL=Qwen3-Embedding-4B-Q4_K_M
# ASTRA_EMBEDDING_API_KEY=
# ASTRA_EMBEDDING_TIMEOUT=2
# Large local session archives may require a larger read budget (milliseconds).
# ASTRA_CONTEXT_INDEX_SESSION_MS=450
# ASTRA_CONTEXT_INDEX_SOURCE_MS=700
# Activity summaries are independent of the chat model; thinking is disabled.
# ASTRA_ACTIVITY_SUMMARY_MODEL=deepseek-flash
# ASTRA_ACTIVITY_SUMMARY_BASE_URL=https://api.deepseek.com
# ASTRA_ACTIVITY_SUMMARY_API_KEY=  # defaults to DEEPSEEK_API_KEY
# Optional OpenAI-compatible Astra API (separate from the upstream model key).
# ASTRA_API_HOST=127.0.0.1
# ASTRA_API_PORT=8900
# ASTRA_API_KEY=  # required for non-loopback binding; protects every endpoint

# Optional private persona configuration; defaults to ASTRA_HOME/persona.local.json
# (or .astra/persona.local.json in a source installation). Never commit this file.
# ASTRA_PERSONA_FILE=
